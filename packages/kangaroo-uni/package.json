      },
      {
        "name": "yhu-cell",
        "path": "components/yhu-cell/yhu-cell.vue"
      },
      {
        "name": "yhu-field",
        "path": "components/yhu-field/yhu-field.vue"
      },
      {
        "name": "yhu-tag",
        "path": "components/yhu-tag/yhu-tag.vue"
      }
    ]
  },
  "peerDependencies": {
    "vue": "^3.0.0",
    "wot-design-uni": "^1.0.0"
  }
}
