{
  "name": "kangaroo-uni",
  "version": "0.1.0",
  "description": "基于 wot-design-uni 二次封装的企业级 uniapp 组件库（npm 包形态，多项目共享）",
  "type": "module",
  "files": [
    "components",
    "theme",
    "index.d.ts"
  ],
  "types": "index.d.ts",
  "scripts": {},
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "uni_modules": {
    "components": [
      {
        "name": "yhu-button",
